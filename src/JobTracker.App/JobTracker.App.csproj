<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\JobTracker.Core\JobTracker.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>JobTracker</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <RootNamespace>JobTracker.App</RootNamespace>
    <!-- WPF0001: ThemeMode (Fluent theme that follows the Windows light/dark setting) is still flagged experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

</Project>
