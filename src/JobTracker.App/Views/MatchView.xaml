<UserControl x:Class="JobTracker.App.Views.MatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,12,8,16">

            <!-- Nothing recognised -->
            <Border Style="{StaticResource Card}" Visibility="{Binding NoTerms, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding Headline}" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding Detail}" />
                </StackPanel>
            </Border>

            <!-- Headline -->
            <Border Style="{StaticResource Card}" Visibility="{Binding HasTerms, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Percent, StringFormat={}{0}%}" FontSize="34" FontWeight="Bold" Foreground="{StaticResource AccentSolid}"
                               VerticalAlignment="Center" Margin="4,0,20,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Headline}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" Height="4" Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Missing -->
            <StackPanel Margin="0,18,0,0" Visibility="{Binding HasMissing, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Not in your resume" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,2,0,8"
                           Text="If you really have used one of these, click I've used it and say where. Rewrites can only talk about what you tell me." />
                <ItemsControl ItemsSource="{Binding Missing}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource SkillChipMissing}" ToolTip="{Binding Tooltip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Skill}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Tag}" Style="{StaticResource SubtleText}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                                               Visibility="{Binding HasTag, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="I've used it" Style="{StaticResource GhostButton}" Padding="8,2" Margin="10,0,0,0" FontSize="12"
                                            Click="MarkUsed_Click" AutomationProperties.Name="{Binding Skill, StringFormat=I have used {0}}" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Width="24" Height="24" Margin="2,0,0,0"
                                            Command="{Binding HideCommand}" ToolTip="Not relevant. Stop counting it" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Claimed -->
            <StackPanel Margin="0,18,0,0" Visibility="{Binding HasAttested, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="You said you have used these" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,2,0,8"
                           Text="They are not in your resume yet. Improve a bullet below to write them in, using your own words." />
                <ItemsControl ItemsSource="{Binding Attested}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource SkillChipClaimed}" ToolTip="{Binding Tooltip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Skill}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Width="24" Height="24" Margin="6,0,0,0"
                                            Command="{Binding UndoCommand}" ToolTip="Take that back" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Covered -->
            <StackPanel Margin="0,18,0,0" Visibility="{Binding HasCovered, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Already in your resume" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Covered}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource SkillChipCovered}" ToolTip="{Binding Tooltip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="11" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Skill}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Tag}" Opacity="0.7" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                                               Visibility="{Binding HasTag, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Visibility="{Binding HasHidden, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource SubtleText}" VerticalAlignment="Center" Text="{Binding HiddenCount, StringFormat={}{0} skill(s) hidden as not relevant.}" />
                <Button Content="Show them again" Style="{StaticResource GhostButton}" Padding="10,3" Margin="10,0,0,0" Command="{Binding RestoreHiddenCommand}" />
            </StackPanel>

            <!-- Rewrite -->
            <Border Style="{StaticResource Card}" Margin="0,22,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Improve bullets for this job" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,2,16,0"
                                   Text="Reword one bullet, reword all the bullets of a job together, or add new bullets to a job, in the job description's words. Anything that adds a number, tool or role you did not write is thrown out before you see it. Your resume file is not changed; you save a new version." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}" Click="ResumeWord_Click" Content="Word document" AutomationProperties.Name="Word document of my resume"
                                ToolTip="See your resume as it is now as a Word document, open its folder, or download it" Margin="0,0,10,0" />
                        <Button Style="{StaticResource PrimaryButton}" Click="Improve_Click" AutomationProperties.Name="Improve bullets" Content="Improve bullets…" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Versions -->
            <StackPanel Margin="0,22,0,0" Visibility="{Binding HasCurrent, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Saved versions of this resume" FontWeight="SemiBold" Margin="0,0,0,8" />
                <!-- The resume in use, first, so it is clear which one the score above is for -->
                <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8" BorderBrush="{StaticResource AccentBorder}" Background="{StaticResource AccentSoft}"
                        AutomationProperties.Name="Resume in use">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Your resume now" FontWeight="SemiBold" />
                                <TextBlock Text="in use" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentSolid}" Margin="8,2,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding CurrentDetail}" Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap">
                                <Run Text="Word file: " /><Run Text="{Binding CurrentFileName, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Word document" Style="{StaticResource GhostButton}" Padding="10,4" VerticalAlignment="Center" Click="ResumeWord_Click"
                                AutomationProperties.Name="Word document of the resume in use"
                                ToolTip="See it as a Word document, with the upload-ready file name, open its folder, or copy it" />
                    </Grid>
                </Border>
                <ItemsControl ItemsSource="{Binding Versions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource SubtleText}" FontSize="12" />
                                        <TextBlock Text="{Binding Score}" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0" Visibility="{Binding HasScore, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Word document" Style="{StaticResource GhostButton}" Padding="10,4" Click="VersionWord_Click"
                                                ToolTip="See this version as a Word document, open its folder, or download it" />
                                        <Button Content="Show file" Style="{StaticResource GhostButton}" Padding="10,4" Margin="8,0,0,0" Command="{Binding ShowCommand}" />
                                        <Button Content="Use as my resume" Style="{StaticResource GhostButton}" Padding="10,4" Margin="8,0,0,0"
                                                Command="{Binding UseAsResumeCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
