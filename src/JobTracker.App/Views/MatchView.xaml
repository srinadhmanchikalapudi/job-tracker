<UserControl x:Class="JobTracker.App.Views.MatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- The insights panel takes a share of the width, between 270 and 340 pixels, so the left side is never squeezed -->
            <ColumnDefinition Width="*" MinWidth="360" />
            <ColumnDefinition Width="0.62*" MinWidth="270" MaxWidth="340" />
        </Grid.ColumnDefinitions>

        <!-- ================================================================ left: the score, the map, the requirements, the versions -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,12,12,16">

                <!-- Nothing recognised -->
                <Border Style="{StaticResource Card}" Visibility="{Binding NoTerms, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding Headline}" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding Detail}" />
                    </StackPanel>
                </Border>

                <!-- The score -->
                <Border Style="{StaticResource Card}" Visibility="{Binding HasTerms, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="4,0,20,0">
                                <TextBlock Text="{Binding Percent, StringFormat={}{0}%}" FontSize="34" FontWeight="Bold" Foreground="{StaticResource AccentSolid}"
                                           AutomationProperties.Name="Overall match" />
                                <TextBlock Text="Overall Match" Style="{StaticResource SubtleText}" FontSize="12" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Headline}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.Name="Requirements matched" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" Height="4" Margin="0,10,0,0" />
                            </StackPanel>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Bars}" Margin="0,14,0,0">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,16,8">
                                        <Grid>
                                            <TextBlock Text="{Binding Label}" FontSize="12" />
                                            <TextBlock Text="{Binding Percent, StringFormat={}{0}%}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        </Grid>
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" Height="3" Margin="0,3,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Score for" VerticalAlignment="Center" Style="{StaticResource SubtleText}" />
                                <ComboBox Width="210" Margin="8,0,0,0" ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding SelectedRole}" DisplayMemberPath="Name"
                                          AutomationProperties.Name="Kind of job to score for"
                                          ToolTip="Different jobs care about different skills: Azure Functions weighs more than Terraform for a .NET job, and the other way round for a cloud job." />
                            </StackPanel>
                            <TextBlock Text="{Binding RoleSummary}" Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- The coverage map -->
                <StackPanel Margin="0,18,0,0" Visibility="{Binding HasTerms, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Coverage map" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,8"
                               Text="✓ in your resume    ~ partly (related wording)    ! you said you used it, but it is not written    ✗ not in your resume. Click any one for details." />
                    <ItemsControl ItemsSource="{Binding Map}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource SubtleText}" FontSize="12" Margin="0,2,0,4" />
                                    <ItemsControl ItemsSource="{Binding Cells}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource MapCell}" Command="{Binding SelectCommand}" ToolTip="{Binding Tooltip}"
                                                        AutomationProperties.Name="{Binding Skill}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Symbol}" FontWeight="Bold" Margin="0,0,6,0" />
                                                        <TextBlock Text="{Binding Skill}" />
                                                        <TextBlock Text="{Binding Tag}" Opacity="0.6" FontSize="11" Margin="6,2,0,0" VerticalAlignment="Center"
                                                                   Visibility="{Binding HasTag, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Missing -->
                <StackPanel Margin="0,18,0,0" Visibility="{Binding HasMissing, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Not in your resume" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,2,0,8"
                               Text="If you really have used one of these, click I've used it and say where. Rewrites can only talk about what you tell me." />
                    <ItemsControl ItemsSource="{Binding Missing}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SkillChipMissing}" ToolTip="{Binding Tooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource ChipLabelButton}" Command="{Binding SelectCommand}" AutomationProperties.Name="{Binding Skill, StringFormat=Details of {0}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Skill}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Tag}" Style="{StaticResource SubtleText}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                                                           Visibility="{Binding HasTag, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Content="I've used it" Style="{StaticResource GhostButton}" Padding="8,2" Margin="10,0,0,0" FontSize="12"
                                                Click="MarkUsed_Click" AutomationProperties.Name="{Binding Skill, StringFormat=I have used {0}}" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Width="24" Height="24" Margin="2,0,0,0"
                                                Command="{Binding HideCommand}" ToolTip="Not relevant. Stop counting it" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Partly matched -->
                <StackPanel Margin="0,18,0,0" Visibility="{Binding HasPartial, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Partly matched" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,2,0,8"
                               Text="Related wording is in your resume, but it does not say the requirement itself. It counts half. If you really used it, say so by name." />
                    <ItemsControl ItemsSource="{Binding Partial}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SkillChipPartial}" ToolTip="{Binding Tooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource ChipLabelButton}" Command="{Binding SelectCommand}" AutomationProperties.Name="{Binding Skill, StringFormat=Details of {0}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="~" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Skill}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Tag}" Style="{StaticResource SubtleText}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                                                           Visibility="{Binding HasTag, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Content="I've used it" Style="{StaticResource GhostButton}" Padding="8,2" Margin="10,0,0,0" FontSize="12"
                                                Click="MarkUsed_Click" AutomationProperties.Name="{Binding Skill, StringFormat=I have used {0}}" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Width="24" Height="24" Margin="2,0,0,0"
                                                Command="{Binding HideCommand}" ToolTip="Not relevant. Stop counting it" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Claimed -->
                <StackPanel Margin="0,18,0,0" Visibility="{Binding HasAttested, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="You said you have used these" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,2,0,8"
                               Text="They are not in your resume yet, so an ATS cannot see them. Click one to write a bullet for it, using your own words." />
                    <ItemsControl ItemsSource="{Binding Attested}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SkillChipClaimed}" ToolTip="{Binding Tooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource ChipLabelButton}" Command="{Binding SelectCommand}" AutomationProperties.Name="{Binding Skill, StringFormat=Details of {0}}">
                                            <TextBlock Text="{Binding Skill}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Width="24" Height="24" Margin="6,0,0,0"
                                                Command="{Binding UndoCommand}" ToolTip="Take that back" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Covered -->
                <StackPanel Margin="0,18,0,0" Visibility="{Binding HasCovered, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Already in your resume" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Covered}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SkillChipCovered}" ToolTip="{Binding Tooltip}">
                                    <Button Style="{StaticResource ChipLabelButton}" Command="{Binding SelectCommand}" AutomationProperties.Name="{Binding Skill, StringFormat=Details of {0}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="11" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Skill}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Tag}" Opacity="0.7" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                                                       Visibility="{Binding HasTag, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Button>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Visibility="{Binding HasHidden, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource SubtleText}" VerticalAlignment="Center" Text="{Binding HiddenCount, StringFormat={}{0} requirement(s) hidden as not relevant.}" />
                    <Button Content="Show them again" Style="{StaticResource GhostButton}" Padding="10,3" Margin="10,0,0,0" Command="{Binding RestoreHiddenCommand}" />
                </StackPanel>

                <!-- Rewrite -->
                <Border Style="{StaticResource Card}" Margin="0,22,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Improve bullets for this job" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,2,16,0"
                                       Text="Reword one bullet, reword all the bullets of a job together, or add new bullets to a job, in the job description's words. Anything that adds a number, tool or role you did not write is thrown out before you see it. Your resume file is not changed; you save a new version." />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostButton}" Click="ResumeWord_Click" Content="Word document" AutomationProperties.Name="Word document of my resume"
                                    ToolTip="See your resume as it is now as a Word document, open its folder, or download it" Margin="0,0,10,0" />
                            <Button Style="{StaticResource PrimaryButton}" Click="Improve_Click" AutomationProperties.Name="Improve bullets" Content="Improve bullets…" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Score history -->
                <StackPanel Margin="0,22,0,0" Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Score history" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,8"
                               Text="How the overall match moved from one version of your resume to the next, and what moved it." />
                    <ItemsControl ItemsSource="{Binding History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                                <TextBlock Text="in use" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentSolid}" Margin="8,2,0,0" VerticalAlignment="Center"
                                                           Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding When}" Style="{StaticResource SubtleText}" FontSize="12" Margin="10,1,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding ChangesText}" Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Visibility="{Binding HasChanges, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Score}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentSolid}" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource SubtleText}" FontSize="12" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Versions -->
                <StackPanel Margin="0,22,0,0" Visibility="{Binding HasCurrent, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Saved versions of this resume" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <!-- The resume in use, first, so it is clear which one the score above is for -->
                    <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8" BorderBrush="{StaticResource AccentBorder}" Background="{StaticResource AccentSoft}"
                            AutomationProperties.Name="Resume in use">
                        <StackPanel>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Your resume now" FontWeight="SemiBold" />
                                    <TextBlock Text="in use" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentSolid}" Margin="8,2,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding CurrentDetail}" Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap">
                                    <Run Text="Word file: " /><Run Text="{Binding CurrentFileName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="{Binding CurrentFileState, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <Button Content="Word document" Style="{StaticResource GhostButton}" Padding="10,4" HorizontalAlignment="Left" Margin="0,8,0,0" Click="ResumeWord_Click"
                                    AutomationProperties.Name="Word document of the resume in use"
                                    ToolTip="See it as a Word document, with the upload-ready file name, open its folder, or copy it" />
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Versions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource SubtleText}" FontSize="12" />
                                            <TextBlock Text="{Binding Score}" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0" TextWrapping="Wrap" Visibility="{Binding HasScore, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Content="Word document" Style="{StaticResource GhostButton}" Padding="10,4" Margin="0,0,8,4" Click="VersionWord_Click"
                                                    ToolTip="See this version as a Word document, open its folder, or download it" />
                                            <Button Content="Show file" Style="{StaticResource GhostButton}" Padding="10,4" Margin="0,0,8,4" Command="{Binding ShowCommand}" />
                                            <Button Content="Use as my resume" Style="{StaticResource GhostButton}" Padding="10,4" Margin="0,0,0,4"
                                                    Command="{Binding UseAsResumeCommand}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ================================================================ right: ATS insights -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasTerms, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="0,12,0,16">
                <TextBlock Text="ATS insights" FontSize="16" FontWeight="SemiBold" Margin="2,0,0,8" />

                <!-- The requirement that was clicked -->
                <Border Style="{StaticResource Card}" Padding="14,12" Visibility="{Binding NoSelection, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource SubtleText}" TextWrapping="Wrap"
                               Text="Click any requirement to see where it is found in your resume, what is close to it, and what you can do about it." />
                </Border>
                <Border Style="{StaticResource Card}" Padding="14,12" BorderBrush="{StaticResource AccentBorder}" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}"
                        AutomationProperties.Name="Requirement details">
                    <StackPanel DataContext="{Binding SelectedDetail}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding LevelText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentSolid}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Width="24" Height="24" ToolTip="Close"
                                    Click="CloseDetail_Click" AutomationProperties.Name="Close details" />
                        </Grid>
                        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" Margin="0,2,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Meta}" Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding JobDescriptionSays, StringFormat=Job description: {0}}" Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />

                        <TextBlock Text="{Binding Lead}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="{Binding HasLead, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding Lines}" Margin="0,4,0,0" Visibility="{Binding HasLines, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="•" />
                                        <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding RelatedLead}" TextWrapping="Wrap" Margin="0,10,0,0" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding RelatedLines}" Margin="0,4,0,0" Visibility="{Binding HasRelated, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="•" />
                                        <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Margin="0,12,0,0" Padding="10,8" CornerRadius="8" Background="{StaticResource AccentSoft}" Visibility="{Binding HasSource, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock FontSize="12">
                                    <Run Text="Source: " /><Run Text="{Binding SourceText, Mode=OneWay}" FontWeight="Bold" />
                                </TextBlock>
                                <TextBlock Text="{Binding SourceExplanation}" Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding Guidance}" Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="{Binding HasGuidance, Converter={StaticResource BoolToVis}}" />

                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="I've used it" Style="{StaticResource PrimaryButton}" Padding="12,6" Margin="0,0,8,6" Click="DetailConfirm_Click"
                                    Visibility="{Binding CanConfirm, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="I have used this" />
                            <Button Content="Write a bullet…" Style="{StaticResource PrimaryButton}" Padding="12,6" Margin="0,0,8,6" Click="DetailWrite_Click"
                                    Visibility="{Binding CanWrite, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Write a bullet for this" />
                            <Button Content="Take that back" Style="{StaticResource GhostButton}" Padding="12,6" Margin="0,0,8,6" Click="DetailUndo_Click"
                                    Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Take back that I used this" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Why this score -->
                <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,12,0,0" AutomationProperties.Name="Why this score">
                    <StackPanel>
                        <TextBlock Text="{Binding WhyTitle}" FontWeight="Bold" />
                        <TextBlock Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,6"
                                   Text="Points out of 100: what your resume earns, and what it loses." />
                        <ItemsControl ItemsSource="{Binding Breakdown}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding PointsText}" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource LossBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Gained}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource GainBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ATS risks -->
                <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,12,0,0" Visibility="{Binding HasRisks, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="ATS risks">
                    <StackPanel>
                        <TextBlock Text="ATS risks" FontWeight="Bold" />
                        <ItemsControl ItemsSource="{Binding Risks}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ChipLabelButton}" Command="{Binding Term.SelectCommand}" Margin="0,3,0,3" HorizontalContentAlignment="Left"
                                            AutomationProperties.Name="{Binding Text}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border CornerRadius="9" Padding="7,1" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#33EF4444" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LevelText}" Value="Medium"><Setter Property="Background" Value="#33F59E0B" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding LevelText}" Value="Low"><Setter Property="Background" Value="#3360A5FA" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding LevelText}" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" TextAlignment="Left" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding MoreRisks}" Style="{StaticResource SubtleText}" FontSize="12" Margin="0,4,0,0" Visibility="{Binding HasMoreRisks, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>

                <!-- Top keywords missing -->
                <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,12,0,0" Visibility="{Binding HasTopMissing, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Top missing keywords">
                    <StackPanel>
                        <TextBlock Text="Top keywords missing" FontWeight="Bold" />
                        <ItemsControl ItemsSource="{Binding TopMissing}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ChipLabelButton}" Command="{Binding Term.SelectCommand}" Margin="0,2,0,2" HorizontalContentAlignment="Left"
                                            AutomationProperties.Name="{Binding Term.Skill}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Rank, StringFormat={}{0}.}" Width="22" Opacity="0.7" />
                                            <TextBlock Text="{Binding Term.Skill}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Term.Tag}" Style="{StaticResource SubtleText}" FontSize="12" Margin="8,1,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
