<Window x:Class="JobTracker.App.MoveFilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Move your applications?" Icon="Assets/app.ico" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="22,18,22,20">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Image Source="{StaticResource LogoImage}" Width="34" Height="34" />
            <TextBlock Text="Move your applications?" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>

        <TextBlock x:Name="Summary" TextWrapping="Wrap" Margin="0,0,0,12" />

        <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="Move them (recommended)" />
                <TextBlock Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="Copies every job description, resume, note and starred bullet to the new folder, checks the copy, then removes the old files. If anything goes wrong, nothing changes." />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="Use the new folder without moving" />
                <TextBlock x:Name="KeepText" Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource GhostButton}" Content="Cancel" Padding="18,8" IsCancel="True" Click="Cancel_Click" />
            <Button x:Name="KeepButton" Style="{StaticResource GhostButton}" Content="Don't move" Margin="10,0,0,0" Padding="18,8"
                    Click="Keep_Click" />
            <Button x:Name="MoveButton" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Padding="22,8" IsDefault="True"
                    Click="Move_Click" />
        </StackPanel>
    </StackPanel>
</Window>
