<Window x:Class="JobTracker.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:JobTracker.App.ViewModels"
        Title="Settings" Icon="Assets/app.ico" Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="22,18,22,20">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Image Source="{StaticResource LogoImage}" Width="34" Height="34" />
            <TextBlock Text="Settings" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>

        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Where applications are saved" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,2,0,8"
                           Text="One folder per company, one subfolder per application. You can change this any time, and move what you have already saved. Uninstalling never deletes it." />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Open" Margin="8,0,0,0"
                            Command="{Binding OpenDataFolderCommand}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Change…" Margin="10,0,0,0"
                            Click="ChangeFolder_Click" IsEnabled="{Binding CanChangeFolder}" />
                    <TextBox Text="{Binding DataRoot, Mode=OneWay}" IsReadOnly="True" Padding="8,6" />
                </DockPanel>
                <StackPanel Margin="0,10,0,0" Visibility="{Binding IsMovingFiles, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding MoveStatus}" TextTrimming="CharacterEllipsis" />
                    <ProgressBar Height="4" Margin="0,6,0,0" Minimum="0" Maximum="100" Value="{Binding MoveProgressPercent, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource SubtleText}" FontSize="12" Margin="0,6,0,0"
                               Text="Please keep Job Tracker open until this finishes." />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" VerticalAlignment="Top" Margin="14,0,0,0" Style="{StaticResource GhostButton}"
                        Content="Move to OneDrive" Click="MoveToOneDrive_Click"
                        Visibility="{Binding CanMoveToOneDrive, Converter={StaticResource BoolToVis}}" />
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE753;" FontSize="18" Margin="0,0,10,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                    <Setter Property="Foreground" Value="#D97706" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BackupIsGood}" Value="True">
                                            <Setter Property="Foreground" Value="#16A34A" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding BackupHeadline}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding BackupDetail}" Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="AI assistance (optional)" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,2,0,10"
                           Text="Rewording resume bullets uses an AI service with your own account key. Only the text of the bullet you pick, the job description and your notes are sent, and only when you click Suggest rewrites." />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Service" VerticalAlignment="Center" Margin="0,0,0,10" />
                    <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:MainViewModel.AiProviderOptions}" SelectedItem="{Binding AiProvider}" Width="180"
                              HorizontalAlignment="Left" Margin="0,0,0,10" AutomationProperties.Name="AI service" />

                    <TextBlock Grid.Row="1" Text="Model" VerticalAlignment="Center" Margin="0,0,0,10" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Refresh list" Margin="8,0,0,0" Command="{Binding RefreshModelsCommand}"
                                    IsEnabled="{Binding CanRefreshModels}" ToolTip="Ask the service which models it offers" AutomationProperties.Name="Refresh model list" />
                            <ComboBox x:Name="ModelBox" IsEditable="True" ItemsSource="{Binding AvailableModels}" Text="{Binding AiModel, UpdateSourceTrigger=LostFocus}"
                                      MaxDropDownHeight="320" SelectionChanged="ModelBox_SelectionChanged" AutomationProperties.Name="AI model" />
                        </DockPanel>
                        <TextBlock Text="{Binding ModelsStatus}" Style="{StaticResource SubtleText}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding AiModelHint}" Style="{StaticResource SubtleText}" FontSize="12" Margin="0,1,0,0" />
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="Key" VerticalAlignment="Top" Margin="0,8,0,0" />
                    <StackPanel Grid.Row="2" Grid.Column="1">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Remove" Margin="8,0,0,0" Click="RemoveKey_Click"
                                    IsEnabled="{Binding HasAiKey}" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Save key" Margin="10,0,0,0" Click="SaveKey_Click" />
                            <PasswordBox x:Name="KeyBox" Padding="8,6" AutomationProperties.Name="API key" />
                        </DockPanel>
                        <TextBlock Text="{Binding AiKeyStatus}" Style="{StaticResource SubtleText}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Text="The key is kept in Windows Credential Manager, not in a file. Text goes to the service you choose here." />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Updates" FontWeight="SemiBold" />
                <CheckBox Content="Look for a new version when the app starts" Margin="0,8,0,0"
                          IsChecked="{Binding CheckForUpdates}"
                          ToolTip="One small request to GitHub, at most once a day. Nothing is installed without asking." />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource GhostButton}" Content="Check for updates now" VerticalAlignment="Top"
                            Command="{Binding CheckForUpdatesNowCommand}" />
                    <!-- Wraps, so a longer sentence (for example when GitHub is limiting requests) is never cut off -->
                    <TextBlock Grid.Column="1" Text="{Binding UpdateStatusText}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"
                               Style="{StaticResource SubtleText}" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="View on GitHub" Margin="8,0,0,0"
                        Command="{Binding OpenRepositoryCommand}" />
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="What's new"
                        Click="WhatsNew_Click" />
                <StackPanel>
                    <TextBlock Text="Job Tracker" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource SubtleText}" />
                    <TextBlock Text="Free and open source (MIT license)." Style="{StaticResource SubtleText}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </StackPanel>
</Window>
