<Window x:Class="JobTracker.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Icon="Assets/app.ico" Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="22,18,22,20">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Image Source="{StaticResource LogoImage}" Width="34" Height="34" />
            <TextBlock Text="Settings" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>

        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Where applications are saved" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,2,0,8"
                           Text="One folder per company, one subfolder per application. You can change this any time, and move what you have already saved. Uninstalling never deletes it." />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Open" Margin="8,0,0,0"
                            Command="{Binding OpenDataFolderCommand}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Change…" Margin="10,0,0,0"
                            Click="ChangeFolder_Click" IsEnabled="{Binding CanChangeFolder}" />
                    <TextBox Text="{Binding DataRoot, Mode=OneWay}" IsReadOnly="True" Padding="8,6" />
                </DockPanel>
                <StackPanel Margin="0,10,0,0" Visibility="{Binding IsMovingFiles, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding MoveStatus}" TextTrimming="CharacterEllipsis" />
                    <ProgressBar Height="4" Margin="0,6,0,0" Minimum="0" Maximum="100" Value="{Binding MoveProgressPercent, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource SubtleText}" FontSize="12" Margin="0,6,0,0"
                               Text="Please keep Job Tracker open until this finishes." />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Updates" FontWeight="SemiBold" />
                <CheckBox Content="Look for a new version when the app starts" Margin="0,8,0,0"
                          IsChecked="{Binding CheckForUpdates}"
                          ToolTip="One small request to GitHub, at most once a day. Nothing is installed without asking." />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Style="{StaticResource GhostButton}" Content="Check for updates now"
                            Command="{Binding CheckForUpdatesNowCommand}" />
                    <TextBlock Text="{Binding UpdateStatusText}" VerticalAlignment="Center" Margin="12,0,0,0"
                               Style="{StaticResource SubtleText}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="View on GitHub"
                        Command="{Binding OpenRepositoryCommand}" />
                <StackPanel>
                    <TextBlock Text="Job Tracker" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource SubtleText}" />
                    <TextBlock Text="Free and open source (MIT license)." Style="{StaticResource SubtleText}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </StackPanel>
</Window>
