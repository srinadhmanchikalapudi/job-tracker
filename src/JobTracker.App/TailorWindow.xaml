<Window x:Class="JobTracker.App.TailorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:JobTracker.App.Views"
        Title="Improve bullets" Icon="Assets/app.ico" Height="820" Width="1180" MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Image Source="{StaticResource LogoImage}" Width="34" Height="34" />
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock FontSize="19" FontWeight="Bold">
                    <Run Text="Improve your resume for" /> <Run Text="{Binding Company, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Style="{StaticResource SubtleText}" FontSize="12"
                           Text="Suggestions use only your resume and what you tell me, and each one is checked before you see it." />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="240" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- The bullets, grouped by job -->
            <Border Style="{StaticResource Card}" Padding="6">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="8,6,8,6">
                    <TextBlock Text="Show" Style="{StaticResource SubtleText}" FontSize="12" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding BulletFilters}" SelectedItem="{Binding SelectedFilter}" DisplayMemberPath="Label"
                              ToolTip="Show every bullet, or only the bullets of one job" AutomationProperties.Name="Show bullets of" />
                </StackPanel>
                <ListBox ItemsSource="{Binding BulletsView}" SelectedItem="{Binding SelectedBullet}" ItemContainerStyle="{StaticResource AppListItem}"
                         BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Resume bullets"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="8,12,8,4" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="#16A34A" Margin="8,0,0,0"
                                           ToolTip="{Binding Mark}" Visibility="{Binding IsChanged, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </Border>

            <!-- Three ways to work -->
            <TabControl Grid.Column="2" Margin="0">

                <!-- ============================================================ new bullets -->
                <TabItem Header="Add new bullets" Padding="14,6" AutomationProperties.Name="Add new bullets">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,14,10,12">
                            <TextBlock Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Text="Add bullets to a job. Tell me what you did there and they are written from your words. Or just type a skill (like Kubernetes) or tick a keyword below, and I will tie it to work this job already describes. Leave everything blank and they can only restate what the job's bullets already say, in a different way." />

                            <TextBlock Text="Add them to" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" DisplayMemberPath="Label" AutomationProperties.Name="Job for new bullets" />

                            <StackPanel Margin="0,14,0,0" Visibility="{Binding HasJob, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Which skills should they speak to? (optional)" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,8"
                                           Text="A skill you said you have used brings your note along, so a bullet can finally say it." />
                                <ItemsControl ItemsSource="{Binding NewSkills}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ToggleButton Style="{StaticResource GhostToggle}" Content="{Binding Skill}" IsChecked="{Binding IsPicked}" Padding="12,4"
                                                          Margin="0,0,8,8" ToolTip="{Binding Tooltip}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Margin="0,4,0,0" Visibility="{Binding HasNewMissing, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Not in your resume: keywords from the job description" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,8"
                                               Text="Tick only the ones you really used in this job. A bullet will then tie each one to work this job already describes, and you check it is true before you add it." />
                                    <ItemsControl ItemsSource="{Binding NewMissingSkills}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ToggleButton Style="{StaticResource MissingSkillToggle}" IsChecked="{Binding IsPicked}" Padding="12,4" Margin="0,0,8,8" ToolTip="{Binding Tooltip}"
                                                              AutomationProperties.Name="{Binding Skill, StringFormat=Keyword {0}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Skill}" />
                                                        <TextBlock Text="{Binding Tag}" Opacity="0.65" FontSize="11" Margin="6,2,0,0" VerticalAlignment="Center"
                                                                   Visibility="{Binding HasTag, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                </ToggleButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <TextBlock Text="What did you do in this job? (optional)" FontWeight="SemiBold" Margin="0,8,0,4" />
                                <TextBox Text="{Binding Answers, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" Padding="8,6"
                                         VerticalScrollBarVisibility="Auto" AutomationProperties.Name="What you did" />
                                <TextBlock Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="For example: what you built or ran, with which tools, how many people or systems it served, and what got better because of it. Only what is true. Or type just a skill, like Kubernetes: I will tie it to the work this job already describes." />
                                <TextBlock Text="{Binding AnswersHint}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0" />

                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding GenerateNewCommand}" IsEnabled="{Binding CanGenerateNew}"
                                        Content="Write new bullets" HorizontalAlignment="Left" Margin="0,14,0,0" AutomationProperties.Name="Write new bullets" />

                                <TextBlock Text="{Binding NewStatus}" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.Name="New bullets status" />

                                <Border Margin="0,8,0,0" CornerRadius="8" Padding="10,8" BorderThickness="1" Background="#26F59E0B" BorderBrush="#80F59E0B"
                                        Visibility="{Binding HasNewNote, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding NewNote}" TextWrapping="Wrap" />
                                </Border>

                                <ItemsControl ItemsSource="{Binding NewOptions}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Note}" Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                                                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Add to this job" Command="{Binding AddCommand}" Padding="14,6"
                                                            Margin="14,0,0,0" VerticalAlignment="Top" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Expander Header="Why some suggestions were dropped" Margin="0,4,0,0"
                                          Visibility="{Binding HasNewRejected, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding NewRejectedSummary}" TextWrapping="Wrap" Style="{StaticResource SubtleText}" Margin="0,6,0,0" />
                                </Expander>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ============================================================ one bullet -->
                <TabItem Header="One bullet" Padding="14,6" AutomationProperties.Name="One bullet">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="0,14,0,0">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60,0,0"
                                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToInverseVis}}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8E1;" FontSize="38" Opacity="0.3" HorizontalAlignment="Center" />
                                <TextBlock Text="Pick a bullet on the left" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" />
                                <TextBlock Style="{StaticResource SubtleText}" HorizontalAlignment="Center" Margin="0,4,0,0" Text="You choose which ones to change. Nothing changes by itself." />
                            </StackPanel>

                            <StackPanel Margin="0,0,10,0" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                                <Border Style="{StaticResource Card}" Padding="16,12">
                                    <StackPanel>
                                        <TextBlock Text="Your bullet" Style="{StaticResource SubtleText}" FontSize="12" />
                                        <TextBlock Text="{Binding SelectedBullet.Text}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Margin="0,16,0,0" Visibility="{Binding HasSkills, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Make it speak to… (optional)" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,8"
                                               Text="Skills the job description asks for that your resume already says, or that you said you have used." />
                                    <ItemsControl ItemsSource="{Binding Skills}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ToggleButton Style="{StaticResource GhostToggle}" Content="{Binding Skill}" IsChecked="{Binding IsPicked}" Padding="12,4"
                                                              Margin="0,0,8,8" ToolTip="{Binding Tooltip}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <TextBlock Text="Anything else that is true about this bullet? (optional)" FontWeight="SemiBold" Margin="0,12,0,4" />
                                <TextBox Text="{Binding ExtraFacts, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="58" Padding="8,6"
                                         VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Extra details" />
                                <TextBlock Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="A number, a tool or a result you know is true. Without it, rewrites cannot add one." />

                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding GenerateCommand}" IsEnabled="{Binding CanGenerate}"
                                            Content="Suggest rewrites" AutomationProperties.Name="Suggest rewrites" />
                                    <Button Style="{StaticResource GhostButton}" Command="{Binding UndoBulletCommand}" Content="Put this bullet back" Margin="10,0,0,0" />
                                </StackPanel>

                                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.Name="Status" />

                                <ItemsControl ItemsSource="{Binding Options}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <views:DiffTextBlock Parts="{Binding Diff}" />
                                                        <TextBlock Text="{Binding Note}" Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                                                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Use this" Command="{Binding UseCommand}" Padding="14,6"
                                                            Margin="14,0,0,0" VerticalAlignment="Top" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Expander Header="Why some suggestions were dropped" Margin="0,4,0,12"
                                          Visibility="{Binding HasRejected, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding RejectedSummary}" TextWrapping="Wrap" Style="{StaticResource SubtleText}" Margin="0,6,0,0" />
                                </Expander>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <!-- ============================================================ a whole job -->
                <TabItem Header="A whole job" Padding="14,6" AutomationProperties.Name="A whole job">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,14,10,12">
                            <TextBlock Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Text="Reword all the bullets of one job together, in the job description's words. Each bullet is checked on its own, and a fact never moves from one bullet to another." />

                            <TextBlock Text="Job" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" DisplayMemberPath="Label" AutomationProperties.Name="Job" />
                            <TextBlock Text="{Binding JobBulletCountText}" Style="{StaticResource SubtleText}" FontSize="12" Margin="0,4,0,0" />

                            <StackPanel Margin="0,14,0,0" Visibility="{Binding HasJob, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Make them speak to… (optional)" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding JobSkills}" Margin="0,8,0,0">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ToggleButton Style="{StaticResource GhostToggle}" Content="{Binding Skill}" IsChecked="{Binding IsPicked}" Padding="12,4"
                                                          Margin="0,0,8,8" ToolTip="{Binding Tooltip}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Anything else that is true about this job? (optional)" FontWeight="SemiBold" Margin="0,8,0,4" />
                                <TextBox Text="{Binding JobExtraFacts, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="58" Padding="8,6"
                                         VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Extra details for the job" />

                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding GenerateJobCommand}" IsEnabled="{Binding CanGenerateJob}"
                                        Content="Suggest rewrites for this job" HorizontalAlignment="Left" Margin="0,16,0,0" AutomationProperties.Name="Suggest rewrites for this job" />

                                <TextBlock Text="{Binding JobStatus}" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.Name="Job status" />

                                <ItemsControl ItemsSource="{Binding JobOptions}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsUsed}" VerticalAlignment="Top" Margin="0,2,12,0" AutomationProperties.Name="Use this change" />
                                                    <StackPanel Grid.Column="1">
                                                        <views:DiffTextBlock Parts="{Binding Diff}" />
                                                        <TextBlock Text="{Binding Note}" Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                                                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding ApplyJobCommand}" IsEnabled="{Binding CanApplyJob}" HorizontalAlignment="Left"
                                        Content="Use the ticked changes" Margin="0,4,0,0" Visibility="{Binding HasJobResult, Converter={StaticResource BoolToVis}}"
                                        AutomationProperties.Name="Use the ticked changes" />

                                <Expander Header="Why some suggestions were dropped" Margin="0,10,0,0"
                                          Visibility="{Binding HasJobRejected, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding JobRejectedSummary}" TextWrapping="Wrap" Style="{StaticResource SubtleText}" Margin="0,6,0,0" />
                                </Expander>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            </TabControl>
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <!-- Always visible, whichever tab is open: the model is being asked, for how long, and a way to stop -->
                <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8" AutomationProperties.Name="Working">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding BusyText}" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.Name="Progress" />
                        <Button Content="Stop" Style="{StaticResource GhostButton}" Padding="12,3" Margin="12,0,0,0" Command="{Binding StopCommand}"
                                AutomationProperties.Name="Stop" ToolTip="Stop waiting for the AI. Nothing is added." />
                    </StackPanel>
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,6,0,0" HorizontalAlignment="Left" Width="360" />
                </StackPanel>
                <TextBlock Text="{Binding ChangesText}" FontWeight="SemiBold" AutomationProperties.Name="Changes" />
                <TextBlock Style="{StaticResource SubtleText}" FontSize="12" Text="Saving makes a new version next to your resume. Your resume itself is not touched." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Content="Use the saved version as my resume" Padding="14,8" Command="{Binding UseSavedAsResumeCommand}"
                        Visibility="{Binding CanUseSaved, Converter={StaticResource BoolToVis}}" />
                <Button Style="{StaticResource GhostButton}" Content="Preview Word document" Margin="10,0,0,0" Padding="14,8" Click="PreviewWord_Click"
                        ToolTip="See the whole resume as a Word document, open its folder, or download it" AutomationProperties.Name="Preview Word document" />
                <Button Style="{StaticResource PrimaryButton}" Content="Save as new version" Margin="10,0,0,0" Padding="20,8" Command="{Binding SaveVersionCommand}"
                        IsEnabled="{Binding CanSave}" AutomationProperties.Name="Save as new version" />
                <Button Style="{StaticResource GhostButton}" Content="Close" Margin="10,0,0,0" Padding="18,8" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
