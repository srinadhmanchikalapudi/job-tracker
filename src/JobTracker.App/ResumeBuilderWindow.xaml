<Window x:Class="JobTracker.App.ResumeBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:JobTracker.App.ViewModels"
        Title="My resume" Icon="Assets/app.ico" Height="860" Width="1180" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Image Source="{StaticResource LogoImage}" Width="34" Height="34" />
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="My resume" FontSize="19" FontWeight="Bold" />
                <TextBlock Style="{StaticResource SubtleText}" FontSize="12"
                           Text="Build a resume from your own answers. It saves as you type, and nothing leaves your computer unless you ask the helper to write a bullet." />
            </StackPanel>
        </StackPanel>

        <TabControl Grid.Row="1">

            <!-- ============================================================ contact -->
            <TabItem Header="Contact" Padding="14,6" AutomationProperties.Name="Contact">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,16,10,16" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="Full name *" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" AutomationProperties.Name="Full name" />

                        <TextBlock Text="Headline" FontWeight="SemiBold" Margin="0,14,0,4" />
                        <TextBox Text="{Binding Headline, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" AutomationProperties.Name="Headline" />
                        <TextBlock Style="{StaticResource SubtleText}" FontSize="12" Margin="0,3,0,0" Text="Your job title or the role you want, for example Senior Software Engineer." />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Email" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" AutomationProperties.Name="Email" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Phone" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" AutomationProperties.Name="Phone" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="City and state" FontWeight="SemiBold" Margin="0,14,0,4" />
                        <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" AutomationProperties.Name="City and state" />

                        <TextBlock Text="Links" FontWeight="SemiBold" Margin="0,14,0,4" />
                        <TextBox Text="{Binding Links, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" AutomationProperties.Name="Links" />
                        <TextBlock Style="{StaticResource SubtleText}" FontSize="12" Margin="0,3,0,0" Text="LinkedIn, GitHub or a portfolio, written the way you want it printed." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================ summary -->
            <TabItem Header="Summary" Padding="14,6" AutomationProperties.Name="Summary">
                <StackPanel Margin="0,16,10,16" MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Text="Summary (optional)" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Summary, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="150" Padding="8,6"
                             VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Summary" />
                    <TextBlock Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="Two or three sentences: what you do, for how long, and what you are best at. Skip it if you would rather let your jobs speak." />
                </StackPanel>
            </TabItem>

            <!-- ============================================================ experience -->
            <TabItem Header="Experience" Padding="14,6" AutomationProperties.Name="Experience">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="290" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}" Padding="8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,2,4,8">
                                <Button Style="{StaticResource PrimaryButton}" Content="Add a job" Padding="12,6" Command="{Binding AddJobCommand}" AutomationProperties.Name="Add a job" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE74A;" Margin="8,0,0,0" ToolTip="Move up" Click="JobUp_Click" AutomationProperties.Name="Move job up" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE74B;" ToolTip="Move down" Click="JobDown_Click" AutomationProperties.Name="Move job down" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Remove this job" Click="RemoveJob_Click" AutomationProperties.Name="Remove job" />
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" ItemContainerStyle="{StaticResource AppListItem}"
                                     BorderThickness="0" Background="Transparent" AutomationProperties.Name="Jobs">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Heading}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,80,0,0"
                                        Visibility="{Binding HasJob, Converter={StaticResource BoolToInverseVis}}">
                                <TextBlock Text="Add your most recent job first" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Style="{StaticResource SubtleText}" HorizontalAlignment="Center" Margin="0,4,0,0"
                                           Text="Click Add a job, then say where you worked and what you did." />
                            </StackPanel>

                            <StackPanel Margin="0,0,10,16" Visibility="{Binding HasJob, Converter={StaticResource BoolToVis}}">
                                <Grid DataContext="{Binding SelectedJob}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="Company *" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Company, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" AutomationProperties.Name="Company" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,0,12">
                                        <TextBlock Text="Job title *" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" AutomationProperties.Name="Job title" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,12">
                                        <TextBlock Text="Location" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" AutomationProperties.Name="Location" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2">
                                        <TextBlock Text="Started" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Start, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" AutomationProperties.Name="Started" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <TextBlock Text="Ended" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding End, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Visibility="{Binding EndVisible, Converter={StaticResource BoolToVis}}"
                                                 AutomationProperties.Name="Ended" />
                                        <CheckBox Content="I still work here" IsChecked="{Binding IsCurrent}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="What you did" FontSize="16" FontWeight="SemiBold" Margin="0,22,0,2" />
                                <TextBlock Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Text="Bullets that say what you did and what changed. Start each with a verb and add a number where you can." />

                                <ItemsControl ItemsSource="{Binding SelectedJob.Bullets}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="•" FontWeight="Bold" Foreground="{StaticResource AccentSolid}" VerticalAlignment="Top" Margin="2,8,10,0" />
                                                    <TextBox Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Padding="8,6" AutomationProperties.Name="Bullet" />
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="6,2,0,0">
                                                        <Button Style="{StaticResource IconButton}" Content="&#xE74A;" Command="{Binding MoveUpCommand}" ToolTip="Move up" />
                                                        <Button Style="{StaticResource IconButton}" Content="&#xE74B;" Command="{Binding MoveDownCommand}" ToolTip="Move down" />
                                                        <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Command="{Binding RemoveCommand}" ToolTip="Remove this bullet" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="{Binding Tip}" FontSize="12" Foreground="#D97706" TextWrapping="Wrap" Margin="24,3,0,0"
                                                           Visibility="{Binding HasTip, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Style="{StaticResource GhostButton}" Content="Add a bullet" HorizontalAlignment="Left" Margin="0,2,0,0" Padding="14,6"
                                        Command="{Binding SelectedJob.AddEmptyBulletCommand}" AutomationProperties.Name="Add a bullet" />

                                <Expander Header="Put a bullet together from parts" Margin="0,22,0,0">
                                    <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                                                       Text="Fill in what you can. Only your own words go in. The tools and the result are optional." />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="I…" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                    <ComboBox IsEditable="True" ItemsSource="{x:Static vm:ResumeBuilderVM.Verbs}" Text="{Binding QuickVerb, UpdateSourceTrigger=PropertyChanged}"
                                                              AutomationProperties.Name="Verb" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="…what" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                    <TextBox Text="{Binding QuickWhat, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" AutomationProperties.Name="What you did" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="Using (optional)" FontWeight="SemiBold" Margin="0,10,0,4" />
                                            <TextBox Text="{Binding QuickTools, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" AutomationProperties.Name="Tools" />
                                            <TextBlock Text="Result (optional)" FontWeight="SemiBold" Margin="0,10,0,4" />
                                            <TextBox Text="{Binding QuickResult, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" AutomationProperties.Name="Result" />
                                            <Border Margin="0,12,0,0" Padding="10,8" CornerRadius="8" Background="{StaticResource AccentSoft}">
                                                <TextBlock Text="{Binding QuickPreview}" TextWrapping="Wrap" AutomationProperties.Name="Bullet preview" />
                                            </Border>
                                            <Button Style="{StaticResource PrimaryButton}" Content="Add this bullet" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="16,7"
                                                    Command="{Binding AddQuickBulletCommand}" IsEnabled="{Binding CanAddQuick}" AutomationProperties.Name="Add this bullet" />
                                        </StackPanel>
                                    </Border>
                                </Expander>

                                <Expander Header="Write bullets from my answers (AI helper)" Margin="0,10,0,0">
                                    <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                                                       Text="Tell me what you did in this job in your own words: what you built or ran, with which tools, how big it was, and what got better. The helper writes bullets using only that. It cannot add a number, a tool or a result you did not write, and anything that does is thrown out. Needs a key in Settings." />
                                            <TextBox Text="{Binding Answers, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" Padding="8,6"
                                                     VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Your answers" />
                                            <Button Style="{StaticResource PrimaryButton}" Content="Write bullets" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="16,7"
                                                    Command="{Binding AskHelperCommand}" IsEnabled="{Binding CanAskHelper}" AutomationProperties.Name="Write bullets" />
                                            <TextBlock Text="{Binding HelperStatus}" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.Name="Helper status" />
                                            <ItemsControl ItemsSource="{Binding HelperOptions}" Margin="0,8,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                                                    <TextBlock Text="{Binding Note}" Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"
                                                                               Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />
                                                                </StackPanel>
                                                                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Add" Command="{Binding AddCommand}" Padding="14,6"
                                                                        Margin="12,0,0,0" VerticalAlignment="Top" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Expander Header="Why some suggestions were dropped" Visibility="{Binding HasHelperRejected, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding HelperRejected}" TextWrapping="Wrap" Style="{StaticResource SubtleText}" Margin="0,6,0,0" />
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                </Expander>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ============================================================ education -->
            <TabItem Header="Education" Padding="14,6" AutomationProperties.Name="Education">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="290" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Padding="8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,2,4,8">
                                <Button Style="{StaticResource PrimaryButton}" Content="Add a school" Padding="12,6" Command="{Binding AddSchoolCommand}" AutomationProperties.Name="Add a school" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Margin="8,0,0,0" ToolTip="Remove this school" Click="RemoveSchool_Click" AutomationProperties.Name="Remove school" />
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Schools}" SelectedItem="{Binding SelectedSchool}" ItemContainerStyle="{StaticResource AppListItem}"
                                     BorderThickness="0" Background="Transparent" AutomationProperties.Name="Schools">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Heading}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                    <StackPanel Grid.Column="2" MaxWidth="700" HorizontalAlignment="Left" Visibility="{Binding HasSchool, Converter={StaticResource BoolToVis}}">
                        <StackPanel DataContext="{Binding SelectedSchool}">
                            <TextBlock Text="School" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBox Text="{Binding School, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" AutomationProperties.Name="School" />
                            <TextBlock Text="Degree or course" FontWeight="SemiBold" Margin="0,12,0,4" />
                            <TextBox Text="{Binding Degree, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" AutomationProperties.Name="Degree" />
                            <TextBlock Text="Dates" FontWeight="SemiBold" Margin="0,12,0,4" />
                            <TextBox Text="{Binding Dates, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" AutomationProperties.Name="Education dates" />
                            <TextBlock Text="Details (optional)" FontWeight="SemiBold" Margin="0,12,0,4" />
                            <TextBox Text="{Binding Details, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" AutomationProperties.Name="Education details" />
                            <TextBlock Style="{StaticResource SubtleText}" FontSize="12" Margin="0,3,0,0" Text="Honours, GPA if it is strong, or relevant coursework." />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60,0,0"
                                Visibility="{Binding HasSchool, Converter={StaticResource BoolToInverseVis}}">
                        <TextBlock Text="No schools yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource SubtleText}" HorizontalAlignment="Center" Margin="0,4,0,0" Text="Click Add a school. You can skip this if it does not help for the jobs you want." />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ============================================================ skills -->
            <TabItem Header="Skills" Padding="14,6" AutomationProperties.Name="Skills">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,16,10,16" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="Skills" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Skills, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" Padding="8,6"
                                 VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Skills" />
                        <TextBlock Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="One group per line, for example: Languages: C#, SQL, Python. Name tools the way job descriptions do (SQL Server, Kubernetes, Kafka): applicant tracking systems look for those words." />

                        <TextBlock Text="Certifications (optional)" FontWeight="SemiBold" Margin="0,20,0,4" />
                        <TextBox Text="{Binding Certifications, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" Padding="8,6"
                                 VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Certifications" />
                        <TextBlock Style="{StaticResource SubtleText}" FontSize="12" Margin="0,6,0,0" Text="One per line." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================ review -->
            <TabItem Header="Review" Padding="14,6" AutomationProperties.Name="Review">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Padding="2">
                        <TextBox Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="14"
                                 FontFamily="Consolas" FontSize="13" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Resume text" />
                    </Border>
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{Binding ProblemsHeading}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.Name="Things to fix" />
                                    <ItemsControl ItemsSource="{Binding Problems}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="•" Foreground="#D97706" FontWeight="Bold" Margin="2,0,8,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" Margin="2,12,0,0"
                                       Text="These are suggestions, not rules. Use the Word document to see the whole page, and use this resume when you add a new application." />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Content="Start over" Padding="14,8" Click="StartOver_Click" ToolTip="Delete this resume and begin again" AutomationProperties.Name="Start over" />
                <TextBlock Text="{Binding SaveStatus}" Style="{StaticResource SubtleText}" VerticalAlignment="Center" Margin="14,0,0,0" AutomationProperties.Name="Save status" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Content="Copy text" Padding="14,8" Click="CopyText_Click" AutomationProperties.Name="Copy text" />
                <Button Style="{StaticResource PrimaryButton}" Content="Preview Word document" Margin="10,0,0,0" Padding="20,8" Click="PreviewWord_Click"
                        ToolTip="See the whole resume as a Word document, open its folder, or download it" AutomationProperties.Name="Preview Word document" />
                <Button Style="{StaticResource GhostButton}" Content="Close" Margin="10,0,0,0" Padding="18,8" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
