<Window x:Class="JobTracker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:JobTracker.App.ViewModels"
        xmlns:views="clr-namespace:JobTracker.App.Views"
        Title="Job Tracker" Icon="Assets/app.ico" Height="800" Width="1280" MinWidth="980" MinHeight="580"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <DockPanel>

            <!-- Header -->
            <Grid DockPanel.Dock="Top" Margin="22,16,22,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource LogoImage}" Width="40" Height="40" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Job Tracker" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="Every application in its own folder, ready for the interview call"
                                   Style="{StaticResource SubtleText}" FontSize="12" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Click="Settings_Click" Margin="0,0,10,0"
                            ToolTip="{Binding DataRoot}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Margin="0,0,8,0" />
                            <TextBlock Text="Settings" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Click="NewApplication_Click" ToolTip="Ctrl+N">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Margin="0,0,8,0" />
                            <TextBlock Text="New application" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid DockPanel.Dock="Bottom" Margin="24,0,22,10">
                <TextBlock Style="{StaticResource SubtleText}" Text="{Binding Summary}" />
                <TextBlock Style="{StaticResource SubtleText}" HorizontalAlignment="Right" Text="{Binding VersionText}" />
            </Grid>

            <!-- A newer version is out: one click installs it (the app closes, updates and starts again). -->
            <Border DockPanel.Dock="Top" Margin="22,0,22,10" Padding="14,10" CornerRadius="10"
                    Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentBorder}" BorderThickness="1"
                    Visibility="{Binding ShowUpdateBanner, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="18" Foreground="{StaticResource AccentSolid}"
                               Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding UpdateBannerText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <ProgressBar Height="4" Margin="0,8,24,0" Minimum="0" Maximum="100" Value="{Binding UpdateProgressPercent, Mode=OneWay}"
                                     Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding CanChooseUpdateAction, Converter={StaticResource BoolToVis}}">
                        <Button Style="{StaticResource PrimaryButton}" Padding="14,6" Content="{Binding UpdateActionText}"
                                Click="UpdateNow_Click" />
                        <Button Style="{StaticResource GhostButton}" Padding="12,6" Margin="8,0,0,0" Content="What's new"
                                Command="{Binding OpenReleasePageCommand}" />
                        <Button Style="{StaticResource GhostButton}" Padding="12,6" Margin="8,0,0,0" Content="Later"
                                Command="{Binding DismissUpdateCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Filters -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="12,10" CornerRadius="10" Margin="22,0,22,10"
                    Visibility="{Binding IsApplicationsTab, Converter={StaticResource BoolToVis}}">
                <WrapPanel VerticalAlignment="Center">
                    <Grid Width="300" Margin="0,0,10,0">
                        <TextBox x:Name="SearchBox" Padding="32,6,8,6" VerticalContentAlignment="Center"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Ctrl+F. Every word must appear in the application." />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Margin="11,0,0,0" Opacity="0.55"
                                   HorizontalAlignment="Left" IsHitTestVisible="False" />
                    </Grid>
                    <TextBlock Text="in" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource SubtleText}" />
                    <ComboBox Width="92" Margin="0,0,14,0" ItemsSource="{x:Static vm:MainViewModel.Scopes}"
                              SelectedItem="{Binding Scope}" ToolTip="Search the job description, the resume, or both" />
                    <CheckBox Content="Matching lines only" VerticalAlignment="Center" Margin="0,0,14,0"
                              IsChecked="{Binding OnlyMatchingLines}" />
                    <CheckBox Content="Starred only" VerticalAlignment="Center" Margin="0,0,14,0"
                              IsChecked="{Binding StarredOnly}" />
                    <ComboBox Width="132" Margin="0,0,10,0" ItemsSource="{x:Static vm:MainViewModel.StatusFilterOptions}"
                              SelectedItem="{Binding StatusFilter}" />
                    <Button Style="{StaticResource GhostButton}" Content="Clear" Padding="12,5"
                            Command="{Binding ClearSearchCommand}" />
                </WrapPanel>
            </Border>

            <TabControl Margin="22,0,22,6" SelectedIndex="{Binding SelectedTabIndex}">

                <!-- Applications -->
                <TabItem Header="Applications" Padding="14,6">
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="350" MinWidth="260" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="6">
                            <ListBox ItemsSource="{Binding ApplicationsView}" SelectedItem="{Binding Selected}"
                                     ItemContainerStyle="{StaticResource AppListItem}" BorderThickness="0" Background="Transparent"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="8,12,8,4">
                                                    <Border Width="24" Height="24" CornerRadius="7"
                                                            Background="{Binding Name, Converter={StaticResource CompanyBrush}}">
                                                        <TextBlock Text="{Binding Name, Converter={StaticResource Initial}}"
                                                                   Foreground="White" FontWeight="Bold" FontSize="12"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                                               Margin="9,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Role}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding DateText}" Style="{StaticResource SubtleText}"
                                                           FontSize="12" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE735;"
                                                           Foreground="{StaticResource StarBrush}" Margin="0,0,8,0"
                                                           Visibility="{Binding IsStarred, Converter={StaticResource BoolToVis}}" />
                                                <Border Style="{StaticResource StatusPill}">
                                                    <TextBlock Text="{Binding Status}" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Center" Background="Transparent" />

                        <Grid Grid.Column="2">
                            <!-- Empty state -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,40"
                                        Visibility="{Binding NoSelection, Converter={StaticResource BoolToVis}}">
                                <Image Source="{StaticResource LogoImage}" Width="88" Height="88" Opacity="0.9" />
                                <TextBlock Text="No applications yet" FontSize="20" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,16,0,4" />
                                <TextBlock Style="{StaticResource SubtleText}" HorizontalAlignment="Center" TextAlignment="Center"
                                           Text="Paste a job page and your resume, and they are saved to a folder for you." />
                                <Button Style="{StaticResource PrimaryButton}" Content="Add your first application"
                                        HorizontalAlignment="Center" Margin="0,18,0,0" Click="NewApplication_Click" />
                            </StackPanel>

                            <Border Style="{StaticResource Card}" Padding="20,18,20,12"
                                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                                <Grid DataContext="{Binding Selected}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="54" Height="54" CornerRadius="15"
                                                    Background="{Binding Company, Converter={StaticResource CompanyBrush}}">
                                                <TextBlock Text="{Binding Company, Converter={StaticResource Initial}}"
                                                           Foreground="White" FontWeight="Bold" FontSize="26"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Company}" FontSize="24" FontWeight="Bold" />
                                                <TextBlock Text="{Binding Role}" FontSize="16" Margin="0,2,0,0" Opacity="0.85" />
                                            </StackPanel>
                                        </StackPanel>

                                        <WrapPanel Margin="0,14,0,0">
                                            <ComboBox Width="132" Margin="0,0,10,0" VerticalContentAlignment="Center"
                                                      ItemsSource="{x:Static vm:MainViewModel.Statuses}"
                                                      SelectedItem="{Binding Status}" />
                                            <Border Style="{StaticResource Card}" CornerRadius="8" Padding="11,6" Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE787;" Margin="0,0,8,0" Opacity="0.7" />
                                                    <TextBlock Text="{Binding DateText}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <ToggleButton Style="{StaticResource GhostToggle}" Margin="0,0,10,0"
                                                          IsChecked="{Binding IsStarred}"
                                                          ToolTip="Star the whole application so you can filter to it">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE735;"
                                                               Foreground="{StaticResource StarBrush}" Margin="0,0,8,0" />
                                                    <TextBlock Text="Starred" />
                                                </StackPanel>
                                            </ToggleButton>
                                            <Button Style="{StaticResource GhostButton}" Command="{Binding OpenFolderCommand}"
                                                    ToolTip="{Binding FolderPath}" Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" Margin="0,0,8,0" />
                                                    <TextBlock Text="Open folder" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource GhostButton}" Command="{Binding OpenUrlCommand}"
                                                    Visibility="{Binding HasUrl, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE71B;" Margin="0,0,8,0" />
                                                    <TextBlock Text="Job link" />
                                                </StackPanel>
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>

                                    <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0,1,0,0"
                                                BorderBrush="{StaticResource DividerBrush}">
                                        <TabItem Header="Job description" Padding="12,5">
                                            <views:DocumentView DataContext="{Binding Jd}" />
                                        </TabItem>
                                        <TabItem Header="Resume" Padding="12,5">
                                            <views:DocumentView DataContext="{Binding Resume}" />
                                        </TabItem>
                                        <TabItem Header="Notes" Padding="12,5">
                                            <Grid Margin="0,12,0,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Style="{StaticResource SubtleText}" Margin="0,0,0,8"
                                                           Text="Interview dates, recruiter names, questions to ask. Saved when you click away." />
                                                <TextBox Grid.Row="1" Text="{Binding Notes}" AcceptsReturn="True" AcceptsTab="True"
                                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10" />
                                            </Grid>
                                        </TabItem>
                                    </TabControl>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- Starred bullets -->
                <TabItem Header="Starred bullets" Padding="14,6">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Grid Width="320" Margin="0,0,10,0">
                                <TextBox Padding="32,6,8,6" VerticalContentAlignment="Center"
                                         Text="{Binding BulletSearch, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Matches the bullet text, company or role" />
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Margin="11,0,0,0" Opacity="0.55"
                                           HorizontalAlignment="Left" IsHitTestVisible="False" />
                            </Grid>
                            <ComboBox Width="132" Margin="0,0,16,0"
                                      ItemsSource="{x:Static vm:MainViewModel.SourceFilterOptions}"
                                      SelectedItem="{Binding BulletSourceFilter}" />
                            <TextBlock Text="{Binding BulletSummary}" VerticalAlignment="Center"
                                       Style="{StaticResource SubtleText}" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding StarredBullets}" Margin="0,0,8,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE735;" FontSize="16"
                                                           Foreground="{StaticResource StarBrush}" VerticalAlignment="Top"
                                                           Margin="0,4,12,0" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                                             BorderThickness="0" Background="Transparent" Padding="0" />
                                                    <TextBlock Text="{Binding Origin}" Style="{StaticResource SubtleText}"
                                                               FontSize="12" Margin="0,6,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top"
                                                            Margin="14,0,0,0">
                                                    <Button Style="{StaticResource PrimaryButton}" Padding="12,6"
                                                            Command="{Binding CopyCommand}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" Margin="0,0,7,0" />
                                                            <TextBlock Text="Copy" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource GhostButton}" Padding="10,6" Margin="8,0,0,0"
                                                            Content="Open application" Command="{Binding OpenApplicationCommand}" />
                                                    <Button Style="{StaticResource GhostButton}" Padding="10,6" Margin="8,0,0,0"
                                                            Content="Unstar" Command="{Binding UnstarCommand}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,40"
                                    IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StarredBullets.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE734;" FontSize="40" Opacity="0.3"
                                       HorizontalAlignment="Center" Margin="0,0,0,10" />
                            <TextBlock Text="No starred bullets here" FontSize="18" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Style="{StaticResource SubtleText}" HorizontalAlignment="Center" Margin="0,4,0,0"
                                       Text="Open an application and star a line to keep it for your next resume." />
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </DockPanel>

        <!-- Toast -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,46" Padding="18,10"
                CornerRadius="10" Background="#F2111827" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" />
            </Border.Effect>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Toast}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Toast}" Foreground="White" FontWeight="SemiBold" MaxWidth="700"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
