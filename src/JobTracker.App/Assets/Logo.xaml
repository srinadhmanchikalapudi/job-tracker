<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brand colours. The logo is a folder with a checkmark: every application gets a folder, every folder gets tracked. -->
    <Color x:Key="BrandIndigo">#6366F1</Color>
    <Color x:Key="BrandBlue">#2563EB</Color>
    <Color x:Key="BrandDeep">#4F46E5</Color>

    <DrawingImage x:Key="LogoImage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Rounded-square tile -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#6366F1" Offset="0" />
                            <GradientStop Color="#2563EB" Offset="1" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,256,256" RadiusX="58" RadiusY="58" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- Folder back panel with tab -->
                <GeometryDrawing Brush="#A6FFFFFF"
                                 Geometry="M52,86 a14,14 0 0 1 14,-14 h42 a14,14 0 0 1 10,4 l14,14 h58 a14,14 0 0 1 14,14 v82 a14,14 0 0 1 -14,14 h-124 a14,14 0 0 1 -14,-14 z" />

                <!-- Folder front panel -->
                <GeometryDrawing Brush="White">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="52,106,152,94" RadiusX="14" RadiusY="14" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- Checkmark -->
                <GeometryDrawing Geometry="M98,154 L118,174 L160,130">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#4F46E5" Thickness="17" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- "My resume": a page with a folded corner, a person and lines of text, in the logo's indigo-to-blue so it reads as a resume at button size. -->
    <DrawingImage x:Key="ResumeIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- A transparent 24 x 24 frame, so the icon is always laid out at the same size -->
                <GeometryDrawing Brush="Transparent">
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,24,24" /></GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- The page -->
                <GeometryDrawing Geometry="M7,2 H14 L20,8 V19 A3,3 0 0 1 17,22 H7 A3,3 0 0 1 4,19 V5 A3,3 0 0 1 7,2 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#6366F1" Offset="0" />
                            <GradientStop Color="#2563EB" Offset="1" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>

                <!-- The folded corner -->
                <GeometryDrawing Brush="#8CFFFFFF" Geometry="M14,2 L20,8 H16.5 A2.5,2.5 0 0 1 14,5.5 Z" />

                <!-- The person -->
                <GeometryDrawing Brush="White">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="9.4,11" RadiusX="1.9" RadiusY="1.9" />
                            <PathGeometry Figures="M5.8,17 A3.6,3.6 0 0 1 13,17 Z" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- Lines of text -->
                <GeometryDrawing Brush="White">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="14.2,10.2,3.8,1.4" RadiusX="0.7" RadiusY="0.7" />
                            <RectangleGeometry Rect="14.2,13.4,3.8,1.4" RadiusX="0.7" RadiusY="0.7" />
                            <RectangleGeometry Rect="6.5,18.8,11.5,1.4" RadiusX="0.7" RadiusY="0.7" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
